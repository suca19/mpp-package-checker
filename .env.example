# Copy to server/.env and fill in. Never commit .env files.
# Challenge-binding secret: openssl rand -base64 32
MPP_SECRET_KEY=
# Receiver wallet address (public, 0x...) that gets paid on Tempo testnet
MPP_RECIPIENT=
# Gemini agent demo (/agent): GEMINI_API_KEY=  AGENT_PRIVATE_KEY=0x... (testnet payer; locally read from .env.payer)  AGENT_MODEL=gemini-2.5-flash
# Optional: PORT (default 3000), HOST (default 127.0.0.1; set 0.0.0.0 when deployed)

# The demo payer lives in .env.payer at the repo root:
#   MPPX_PRIVATE_KEY=0x...  PAYER_ADDRESS=0x...  MPPX_RPC_URL=https://rpc.moderato.tempo.xyz
